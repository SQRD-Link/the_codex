# mappa-sync. Copy to .env next to docker-compose.yml.
# Each key lives in 1Password (vault homelab-api, items titled "Mappa | API | ...").
# Every key is READ-ONLY: sync.py only issues GET requests, plus the Omada token request.
# After editing .env: docker compose up -d --force-recreate mappa-sync   (a plain restart keeps the old values)

# Required. 1Password: "Mappa | API | Netbox-read". NetBox v2 token ("nbt_<key>.<secret>"), read-only.
# The token's allowed_ips must include the source NetBox sees for mappa-sync (currently 172.18.0.0/16, the docker network).
NETBOX_URL=https://netbox.sqrd.link
NETBOX_TOKEN=

# Optional: Proxmox (lxc vs vm, running/stopped). 1Password: "Mappa | API | grimoire-read".
# Token ID is the item's username (mappa@pam!mappa), secret is its password.
# Needs PVEAuditor on / (also on the token itself if privilege separation is on).
PROXMOX_URL=https://10.10.10.10:8006
PROXMOX_TOKEN_ID=mappa@pam!mappa
PROXMOX_TOKEN_SECRET=
# 0 only while grimoire serves its self-signed cert
PROXMOX_VERIFY_TLS=0

# Optional: Omada OpenAPI (client counts per VLAN, live gateway ACL drift). 1Password: "Mappa | API | omada-read".
# Client ID is the item's username, client secret its password (app under Settings > Platform Integration, read-only role).
# Keep OMADA_URL on the Pangolin hostname: centuries may reach nastradamus on 4443 only (ACL rule 6), not on the controller's own port.
# OMADA_ID is an identifier, not a secret. Get it with: curl -sk https://10.10.10.20:30077/api/info | jq -r .result.omadacId
OMADA_URL=https://omada.sqrd.link
OMADA_ID=5b2c5e6f81ebfc3a8104585353e83666
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
# Site name as shown in Omada (not "Default")
OMADA_SITE=la-rocca
OMADA_VERIFY_TLS=1

# Optional: Arcane (running compose projects per host). 1Password: "Mappa | API | arcane-read".
# One Arcane environment per host, named after the host id (centuries, modcaves, nastradamus).
# Key permissions: environments:list (global) and containers:list. Nothing else.
# Use a hostname that skips Pangolin SSO for centuries (a resource with an ACCEPT rule for 10.10.100.75),
# otherwise the API key never reaches Arcane. centuries cannot reach nastradamus directly (Servers -> Management is denied).
ARCANE_URL=https://docker.sqrd.link
ARCANE_API_KEY=
ARCANE_VERIFY_TLS=1

# Seconds between syncs
SYNC_INTERVAL=3600
