# mappa-sync. Copy to .env next to docker-compose.yml.

# Required. Read-only NetBox API token is enough.
NETBOX_URL=https://netbox.sqrd.link
NETBOX_TOKEN=

# Optional: Proxmox (lxc vs vm, running/stopped). API token with PVEAuditor on /.
PROXMOX_URL=https://10.10.10.10:8006
PROXMOX_TOKEN_ID=mappa@pve!sync
PROXMOX_TOKEN_SECRET=
# 0 only if grimoire still serves its self-signed cert
PROXMOX_VERIFY_TLS=0

# Optional: Omada OpenAPI (client counts per VLAN). Create an app under Settings > Platform Integration.
OMADA_URL=https://omada.sqrd.link
OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_SITE=Default
OMADA_VERIFY_TLS=1

# Seconds between syncs
SYNC_INTERVAL=3600
