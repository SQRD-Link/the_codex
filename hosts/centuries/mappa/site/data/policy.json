{
  "$schema": "../../schema/policy.schema.json",
  "meta": {
    "title": "Pianta della Rete",
    "subtitle": "The SQRD network, drawn as a fortified city",
    "author": "per mano dell'ingegnere di casa",
    "updated": "2026-10-08",
    "notes": [
      "Every road between wards passes through the citadel. There is no other way across.",
      "The long thread (Tailscale) comes in under the walls, but the gate still judges it."
    ]
  },
  "gateway": {
    "id": "la-porta",
    "label": "La Porta",
    "model": "TP-Link ER605",
    "ip_suffix": ".254",
    "note": "Gateway ACL, first match wins, all inter-VLAN traffic"
  },
  "vlans": [
    {
      "id": "servers",
      "vid": 100,
      "name": "Servers",
      "art": "Officina",
      "subnet": "10.10.100.0/24",
      "purpose": "LXC, VM and Docker homelab",
      "tailscale": true,
      "order": 0
    },
    {
      "id": "iot",
      "vid": 20,
      "name": "IoT",
      "art": "Congegni",
      "subnet": "10.10.20.0/24",
      "purpose": "Smart-home devices, blast radius contained",
      "tailscale": false,
      "order": 1,
      "clients": "Hue, Nest, Wiz, cameras"
    },
    {
      "id": "trusted",
      "vid": 30,
      "name": "Trusted",
      "art": "Familiari",
      "subnet": "10.10.30.0/24",
      "purpose": "Richard's devices, casting and media gear",
      "tailscale": false,
      "order": 2,
      "clients": "Richard's devices, casters"
    },
    {
      "id": "mgmt",
      "vid": 10,
      "name": "Management",
      "art": "Governo",
      "subnet": "10.10.10.0/24",
      "purpose": "Proxmox, TrueNAS, PBS, switch, APs",
      "tailscale": true,
      "order": 3
    },
    {
      "id": "leo",
      "vid": 50,
      "name": "Leo",
      "art": "Il Fanciullo",
      "subnet": "10.10.50.0/24",
      "purpose": "Leo's devices, SSID live 07:00 to 20:00",
      "tailscale": false,
      "order": 4,
      "clients": "Leo's devices"
    },
    {
      "id": "guest",
      "vid": 40,
      "name": "Guest",
      "art": "Ospizio",
      "subnet": "10.10.40.0/24",
      "purpose": "Guest WiFi, internet only",
      "tailscale": false,
      "order": 5,
      "clients": "Guest WiFi"
    }
  ],
  "aliases": {
    "fw": "la-porta",
    "er605": "la-porta",
    "beneden": "piano-terra",
    "ap-beneden": "piano-terra",
    "boven": "piano-nobile",
    "ap-boven": "piano-nobile",
    "prox": "grimoire",
    "proxy": "pangolin",
    "local docker": "nastradamus",
    "minecraft-docker": "modcaves",
    "centuries-docker": "centuries"
  },
  "host_overrides": {
    "pangolin": {
      "public": true,
      "note": "Internal and public edge. Router port-forward, no VPS, no tunnel."
    },
    "hassanova": {
      "lean": "iot",
      "note": "IP sits in Servers (.100.55), but it tends the IoT ward through a postern gate (rules 7-8)."
    },
    "teelskeel": {
      "lean": "guest",
      "note": "Native tailscaled on Ubuntu LXC, not Docker. Subnet router and exit node."
    },
    "grimoire": {
      "note": "Still dual-homed on 10.10.100.8 (legacy interface, not yet retired)."
    },
    "nastradamus": {
      "note": "Still dual-homed on 10.10.100.12 (legacy interface, not yet retired)."
    }
  },
  "edge": {
    "internet": {
      "label": "Il Mondo",
      "note": "Static home IP"
    },
    "cloudflare": {
      "label": "Cloudflare",
      "domain": "prtsr.nl",
      "mode": "DNS only, not proxied"
    },
    "port_forwards": [
      {
        "to": "host:pangolin",
        "ports": "web + raw TCP (e.g. Minecraft)",
        "note": "Router port-forward straight to Pangolin"
      }
    ]
  },
  "tailscale": {
    "host": "teelskeel",
    "routes": [
      "servers",
      "mgmt"
    ],
    "exit_node": true,
    "note": "IoT, Trusted, Leo and Guest are deliberately not routed."
  },
  "dns": [
    {
      "record": "*.sqrd.link",
      "target": "host:pangolin",
      "value": "10.10.100.252",
      "note": "Wildcard default"
    },
    {
      "record": "grimoire.sqrd.link",
      "target": "host:centuries",
      "value": "10.10.100.75",
      "note": "AdGuard rewrite, bypasses Pangolin on purpose"
    },
    {
      "record": "nastradamus.sqrd.link",
      "target": "host:centuries",
      "value": "10.10.100.75",
      "note": "AdGuard rewrite, same as above"
    },
    {
      "record": "omada.sqrd.link",
      "target": "host:nastradamus",
      "value": "10.10.10.20:30077",
      "note": "Omada controller on nastradamus. Resolves through the wildcard to Pangolin, which proxies to the controller"
    },
    {
      "record": "*.prtsr.nl",
      "target": "edge:cloudflare",
      "value": "static home IP",
      "note": "Public, DNS only (raw TCP works)"
    }
  ],
  "dns_servers": [
    {
      "label": "AdGuard 1 (primary)",
      "host": "adguard",
      "ip": "10.10.100.1"
    },
    {
      "label": "AdGuard 2 (secondary)",
      "host": "nastradamus",
      "ip": "10.10.100.2",
      "note": "Docker on nastradamus, synced via adguardhome-sync"
    }
  ],
  "acl": {
    "default": "unknown",
    "default_note": "All 16 gateway rules are listed in Omada order. Traffic that matches none of them is not documented.",
    "source": "Omada live gateway ACL, read through the Open API (GET). Omada is the source of truth; sync.py only compares and reports drift.",
    "rules": [
      {
        "id": "r1",
        "rules": "1",
        "action": "permit",
        "from": [
          "vlan:servers",
          "vlan:mgmt",
          "vlan:iot",
          "vlan:trusted",
          "vlan:leo",
          "vlan:guest"
        ],
        "to": [
          "host:adguard"
        ],
        "verified": true,
        "note": "Omada 'allow all-vlans > dns'. The group also holds the secondary resolver 10.10.100.2 (AdGuard on nastradamus), which has no host record, so sync still lists it as an ip: difference"
      },
      {
        "id": "r2",
        "rules": "2",
        "action": "permit",
        "from": [
          "vlan:servers",
          "vlan:mgmt",
          "vlan:trusted",
          "vlan:leo",
          "vlan:guest"
        ],
        "to": [
          "host:pangolin"
        ],
        "verified": true,
        "note": "Omada 'allow servers,mgmt,trusted,leo,guest > pangolin', any port. IoT is deliberately not a source"
      },
      {
        "id": "r3",
        "rules": "3",
        "action": "permit",
        "from": [
          "host:pangolin"
        ],
        "to": [
          "vlan:servers",
          "vlan:mgmt",
          "vlan:iot",
          "vlan:trusted",
          "vlan:leo",
          "vlan:guest"
        ],
        "verified": true,
        "note": "Omada 'allow pangolin > all-vlans'. Pangolin reaches every VLAN"
      },
      {
        "id": "r4",
        "rules": "4",
        "action": "permit",
        "from": [
          "host:centuries"
        ],
        "to": [
          "host:grimoire",
          "host:nastradamus"
        ],
        "ports": [
          22
        ],
        "verified": true,
        "note": "Omada 'allow centuries > mgmt-ssh'. SSH into Management only from centuries"
      },
      {
        "id": "r5",
        "rules": "5",
        "action": "permit",
        "from": [
          "host:centuries",
          "host:teelskeel"
        ],
        "to": [
          "host:grimoire"
        ],
        "ports": [
          8006
        ],
        "verified": true,
        "note": "Omada 'allow centuries,tailscale > grimoire-pve'. Proxmox web UI"
      },
      {
        "id": "r6",
        "rules": "6",
        "action": "permit",
        "from": [
          "host:centuries",
          "host:teelskeel"
        ],
        "to": [
          "host:nastradamus"
        ],
        "ports": [
          4443
        ],
        "verified": true,
        "note": "Omada 'allow centuries,tailscale > nastradamus-truenas'. TrueNAS web UI"
      },
      {
        "id": "r7",
        "rules": "7",
        "action": "permit",
        "from": [
          "host:hassanova"
        ],
        "to": [
          "vlan:iot"
        ],
        "verified": true,
        "note": "Omada 'allow homeassistant > iot'. Home Assistant tends the IoT ward"
      },
      {
        "id": "r8",
        "rules": "8",
        "action": "permit",
        "from": [
          "vlan:iot"
        ],
        "to": [
          "host:hassanova"
        ],
        "verified": true,
        "note": "Omada 'allow iot > homeassistant'. IoT devices report back to Home Assistant"
      },
      {
        "id": "r9",
        "rules": "9",
        "action": "permit",
        "from": [
          "vlan:trusted"
        ],
        "to": [
          "host:plex"
        ],
        "ports": [
          32400
        ],
        "verified": true,
        "note": "Omada 'allow trusted > plex'"
      },
      {
        "id": "r10",
        "rules": "10",
        "action": "permit",
        "from": [
          "host:plex"
        ],
        "to": [
          "host:nastradamus"
        ],
        "ports": [
          2049
        ],
        "verified": true,
        "note": "Omada 'allow plex > nastradamus-nfs'. NFS media share"
      },
      {
        "id": "r11",
        "rules": "11",
        "action": "permit",
        "from": [
          "vlan:leo"
        ],
        "to": [
          "host:plex"
        ],
        "ports": [
          32400
        ],
        "verified": true,
        "note": "Omada 'allow leo > plex'"
      },
      {
        "id": "r12",
        "rules": "12",
        "action": "permit",
        "from": [
          "vlan:leo"
        ],
        "to": [
          "host:modcaves"
        ],
        "verified": true,
        "note": "Omada 'allow leo > minecraft'"
      },
      {
        "id": "r13",
        "rules": "13",
        "action": "permit",
        "from": [
          "vlan:leo"
        ],
        "to": [
          "host:hassanova"
        ],
        "verified": true,
        "note": "Omada 'allow leo > homeassistant'"
      },
      {
        "id": "r14",
        "rules": "14",
        "action": "permit",
        "from": [
          "vlan:trusted"
        ],
        "to": [
          "host:hassanova"
        ],
        "verified": true,
        "note": "Omada 'allow trusted > homeassistant'"
      },
      {
        "id": "r15",
        "rules": "15",
        "action": "deny",
        "from": [
          "vlan:iot",
          "vlan:trusted",
          "vlan:leo",
          "vlan:guest"
        ],
        "to": [
          "vlan:servers"
        ],
        "verified": true,
        "note": "Omada 'deny clients > servers'. No direct IP into Servers from client VLANs"
      },
      {
        "id": "r16",
        "rules": "16",
        "action": "deny",
        "from": [
          "vlan:servers",
          "vlan:iot",
          "vlan:trusted",
          "vlan:leo",
          "vlan:guest"
        ],
        "to": [
          "vlan:mgmt"
        ],
        "verified": true,
        "note": "Omada 'deny servers,clients > mgmt'. Management to Management needs no deny; Management to Servers has none either"
      }
    ]
  },
  "expect": {
    "no_ansible": [
      "hassanova",
      "grimoire",
      "nastradamus"
    ],
    "not_in_proxmox": [
      "pbs"
    ],
    "vlan": {
      "grimoire": "mgmt",
      "nastradamus": "mgmt",
      "pbs": "mgmt",
      "switch": "mgmt",
      "piano-terra": "mgmt",
      "piano-nobile": "mgmt"
    },
    "no_pangolin_auth": [
      "hassanova",
      "verzoekjes"
    ]
  },
  "naming": {
    "theme": "Nostradamus for hosts and storage; Italian (Da Vinci era) for wards, the gateway and the access points.",
    "rules": [
      "lowercase, hyphen-separated, hostname-safe (RFC 1123)",
      "rename in the source that owns the name (Omada for gateway/switch/APs, Proxmox for guests, NetBox for the rest), never only in NetBox",
      "keep the old name in policy.aliases until the Errata stop mentioning it"
    ],
    "names": {
      "la-porta": "ER605 gateway. 'The gate': every road between wards passes through it",
      "piano-terra": "EAP245 downstairs (was beneden). Ground floor of the palazzo",
      "piano-nobile": "EAP225 upstairs (was boven). The grand first floor of the palazzo"
    }
  }
}
