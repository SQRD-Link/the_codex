{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "inventory.schema.json",
  "title": "Pianta della Rete: inventory (generated by tools/sync.py, never hand-edited)",
  "type": "object",
  "required": ["generated_at", "hosts"],
  "properties": {
    "$schema": { "type": "string" },
    "generated_at": { "type": "string" },
    "generator": { "type": "string" },
    "sources": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$" },
          "ip": { "type": ["string", "null"] },
          "kind": { "enum": ["hypervisor", "nas", "vm", "lxc", "container", "switch", "ap", "device", "gateway"] },
          "role": { "type": ["string", "null"] },
          "model": { "type": "string" },
          "parent": { "type": "string" },
          "status": { "type": ["string", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "legacy_ips": { "type": "array", "items": { "type": "string" } },
          "services": { "type": "array", "items": { "type": "string" } },
          "stores": { "type": "array", "items": { "type": "string" } },
          "netbox_id": { "type": "integer" },
          "vmid": { "type": ["integer", "null"] },
          "vlan": { "type": "string" }
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "vlan", "label"],
        "properties": { "id": { "type": "string" }, "vlan": { "type": "string" }, "label": { "type": "string" }, "count": { "type": ["integer", "null"] } }
      }
    },
    "drift": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "object", "message"],
        "properties": { "severity": { "enum": ["info", "warn"] }, "object": { "type": "string" }, "message": { "type": "string" } }
      }
    }
  }
}
